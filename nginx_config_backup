server {
    listen 80;
    server_name testdone.in www.testdone.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name testdone.in www.testdone.in;

    ssl_certificate /etc/letsencrypt/live/testdone.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testdone.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Increase upload size for PDFs
    client_max_body_size 50M;

    # Frontend Static Assets - Bypass Next.js Server for performance & stability
    location /_next/static/ {
        alias /var/www/testdone/frontend/.next/static/;
        expires 365d;
        access_log off;
    }

    # Public Assets
    location /public/ {
        alias /var/www/testdone/frontend/public/;
        expires 365d;
        access_log off;
    }

    # Backend API Proxy - Direct to Backend Port 5000
    location /api {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frontend Proxy - Everything else to Next.js Port 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase buffers to prevent 400 Bad Request
        proxy_busy_buffers_size   512k;
        proxy_buffers   4 512k;
        proxy_buffer_size   256k;
    }
}
