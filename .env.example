# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/testdone?schema=public"

# Backend
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secrets (generate your own in production!)
JWT_ACCESS_SECRET=testdone_access_secret_change_in_production_abc123
JWT_REFRESH_SECRET=testdone_refresh_secret_change_in_production_xyz789
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Settings
OTP_EXPIRY_MINUTES=5

# Email (Optional - for OTP and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@testdone.in

# SMS (Optional - for OTP)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=TESTDN

# Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@testdone.in
ADMIN_PASSWORD=Admin@123456
